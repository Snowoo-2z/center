<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       PALETTE  — noir carbone, blanc pur, gris très clairs
       ============================================================ -->
  <SolidColorBrush x:Key="CanvasBrush"          Color="#121212" />
  <SolidColorBrush x:Key="SidebarBrush"         Color="#161616" />
  <SolidColorBrush x:Key="SurfaceBrush"         Color="#1B1B1B" />
  <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="#222222" />
  <SolidColorBrush x:Key="SurfacePressedBrush"  Color="#2A2A2A" />
  <SolidColorBrush x:Key="BorderBrush"          Color="#242424" />
  <SolidColorBrush x:Key="BorderStrongBrush"    Color="#2E2E2E" />
  <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#A6A6A6" />
  <SolidColorBrush x:Key="TextMutedBrush"       Color="#6B6B6B" />
  <SolidColorBrush x:Key="InkBrush"             Color="#111111" />
  <SolidColorBrush x:Key="SuccessBrush"         Color="#4ADE80" />
  <SolidColorBrush x:Key="DangerBrush"          Color="#F87171" />
  <SolidColorBrush x:Key="SwitchOffBrush"       Color="#2A2A2A" />
  <SolidColorBrush x:Key="SwitchKnobOffBrush"   Color="#8A8A8A" />
  <SolidColorBrush x:Key="SwitchOnBrush"        Color="#F2F2F2" />
  <SolidColorBrush x:Key="CodeBgBrush"          Color="#0E0E0E" />
  <SolidColorBrush x:Key="CodeBorderBrush"      Color="#232323" />

  <!-- Fluent TextBox internals: flat, borderless, dark -->
  <SolidColorBrush x:Key="TextControlBackground"                     Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver"          Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused"              Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBorderBrush"                    Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"         Color="Transparent" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused"             Color="Transparent" />
  <SolidColorBrush x:Key="TextControlForeground"                     Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver"          Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextControlForegroundFocused"              Color="#F2F2F2" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground"          Color="#6B6B6B" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A8A8A" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"   Color="#8A8A8A" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor"        Color="#3DFFFFFF" />

  <!-- No border at all, even when focused (focus ring handled by the parent Border) -->
  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

  <!-- ============================================================
       BUTTONS
       ============================================================ -->

  <!-- Discreet button: sidebar items, sources, "Nouveau chat" -->
  <ControlTheme x:Key="AppButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- White primary button: send -->
  <ControlTheme x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="#E2E2E2" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="#C9C9C9" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       CONNECTOR SWITCH (ToggleButton)
       ============================================================ -->
  <ControlTheme x:Key="SwitchTheme" TargetType="ToggleButton">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track"
                Width="34" Height="20"
                CornerRadius="10"
                Background="{DynamicResource SwitchOffBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1">
          <Border Name="PART_Knob"
                  Width="14" Height="14"
                  CornerRadius="7"
                  Background="{DynamicResource SwitchKnobOffBrush}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Margin="2,0,0,0" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource SwitchOnBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SwitchOnBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Knob">
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Track">
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
