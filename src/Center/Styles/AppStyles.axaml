<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Small uppercase section titles -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Chat rows -->
  <Style Selector="Border.assistant">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.user">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="MaxWidth" Value="620" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#1E1E1E" />
    <Setter Property="BorderBrush" Value="#262626" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Composer: flat, borderless TextBox -->
  <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- "typing" indicator -->
  <Style Selector="StackPanel.thinking">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Active conversation in the sidebar -->
  <Style Selector="Button.active /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

</Styles>
